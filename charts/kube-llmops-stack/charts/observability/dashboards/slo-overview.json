{
  "uid": "slo-overview",
  "title": "SLO Overview - Availability, Latency, Quality",
  "tags": ["slo", "reliability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {"id":1,"title":"LLM Inference Availability (30d)","type":"stat","gridPos":{"h":4,"w":8,"x":0,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"1 - (sum(increase(vllm:request_success_total{status!=\"200\"}[30d])) / sum(increase(vllm:request_success_total[30d])))","legendFormat":"Availability"}],"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"steps":[{"color":"red","value":null},{"color":"yellow","value":0.99},{"color":"green","value":0.999}]}}}},
    {"id":2,"title":"E2E Latency P95 (target: <2s)","type":"stat","gridPos":{"h":4,"w":8,"x":8,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(vllm:e2e_request_latency_seconds_bucket[5m])) by (le))","legendFormat":"P95"}],"fieldConfig":{"defaults":{"unit":"s","thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":2}]}}}},
    {"id":3,"title":"RAG Quality Score","type":"stat","gridPos":{"h":4,"w":8,"x":16,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"ragas_faithfulness","legendFormat":"Faithfulness"}],"fieldConfig":{"defaults":{"thresholds":{"steps":[{"color":"red","value":null},{"color":"yellow","value":0.7},{"color":"green","value":0.85}]}}}},
    {"id":4,"title":"Error Budget Burn Rate","type":"timeseries","gridPos":{"h":8,"w":24,"x":0,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(vllm:request_success_total[5m]))","legendFormat":"Success Rate"},{"expr":"sum(rate(vllm:request_success_total[5m])) * 0.001","legendFormat":"Error Budget (0.1%)"}]}
  ],
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "30s"
}
